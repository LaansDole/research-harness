#!/usr/bin/env bash
# Research-mode launcher: loads persisted settings, exports the research env,
# and starts omp (the fork's dev wrapper when runnable, else the installed omp)
# with the research system prompt.
# Usage: research [omp args...] | research doctor | research web | research update [--check]
set -euo pipefail

CONFIG="$HOME/.research-harness/config.env"
if [ -f "$CONFIG" ]; then
	# shellcheck disable=SC1090
	. "$CONFIG"
fi

# Resolve the repo root even when settings are missing (script may be a symlink).
if [ -z "${RESEARCH_HARNESS_HOME:-}" ] || [ ! -d "${RESEARCH_HARNESS_HOME:-}" ]; then
	src="${BASH_SOURCE[0]}"
	while [ -L "$src" ]; do src="$(readlink "$src")"; done
	RESEARCH_HARNESS_HOME="$(cd "$(dirname "$src")/.." && pwd)"
fi

export RESEARCH_HARNESS_HOME
export PAPER_GRAPH_DB="${PAPER_GRAPH_DB:-$HOME/.research-harness/papers.db}"
if [ -n "${RESEARCH_CORPUS_DIR:-}" ]; then
	export RESEARCH_CORPUS_DIR
fi

# Brand the TUI welcome screen (consumed by packages/utils/src/branding.ts).
BRAND_DIR="$RESEARCH_HARNESS_HOME/research/branding"
export RESEARCHHARNESS_BRAND_NAME="${RESEARCHHARNESS_BRAND_NAME:-Research Harness}"
if [ -f "$BRAND_DIR/logo.txt" ]; then
	export RESEARCHHARNESS_BRAND_LOGO="$BRAND_DIR/logo.txt"
fi
if [ -f "$BRAND_DIR/tips.txt" ]; then
	export RESEARCHHARNESS_BRAND_TIPS="$BRAND_DIR/tips.txt"
fi

SYSTEM_PROMPT="$RESEARCH_HARNESS_HOME/research/mode/system.md"
OMP_AGENT_DIR="${OMP_AGENT_DIR:-$HOME/.omp/agent}"

ok() { printf '  ok    %s\n' "$1"; }
warn() { printf '  warn  %s\n' "$1"; }
fail() {
	printf '  FAIL  %s\n' "$1"
	DOCTOR_FAILED=1
}

doctor() {
	# All locals: doctor runs inside update(), where a leaked `count` would
	# overwrite the new-commit count printed after it.
	local a f ext base stats count active
	DOCTOR_FAILED=0
	echo "research doctor"

	if command -v omp >/dev/null 2>&1; then
		ok "omp $(omp --version 2>/dev/null | head -1) at $(command -v omp)"
	else
		fail "omp not on PATH"
	fi

	if command -v omp >/dev/null 2>&1 && omp plugin list 2>/dev/null | grep -q "research-harness-tools"; then
		ok "plugin research-harness-tools installed"
	else
		fail "plugin research-harness-tools not installed (run setup.sh)"
	fi

	ext="$HOME/.omp/plugins/node_modules/research-harness-tools/extensions/research-mode/index.ts"
	if [ -f "$ext" ]; then
		ok "extension research-mode (/help guide + statusline)"
	else
		fail "extension research-mode missing from the installed plugin (run setup.sh)"
	fi

	for a in scholar screener synthesizer librarian; do
		if [ -f "$OMP_AGENT_DIR/agents/$a.md" ]; then
			ok "agent $a"
		else
			fail "agent $a missing from $OMP_AGENT_DIR/agents/"
		fi
	done

	local missing_prompts=0 n_prompts=0
	for f in "$RESEARCH_HARNESS_HOME"/research/prompts/*.md; do
		base="$(basename "$f")"
		n_prompts=$((n_prompts + 1))
		if [ ! -f "$OMP_AGENT_DIR/prompts/$base" ]; then
			fail "prompt /${base%.md} missing from $OMP_AGENT_DIR/prompts/"
			missing_prompts=$((missing_prompts + 1))
		fi
	done
	if [ "$missing_prompts" -eq 0 ]; then
		ok "prompts ($n_prompts commands installed)"
	fi

	if [ -f "$SYSTEM_PROMPT" ]; then
		ok "mode system prompt $SYSTEM_PROMPT"
	else
		fail "mode system prompt missing: $SYSTEM_PROMPT"
	fi

	if [ -f "$CONFIG" ]; then
		ok "config $CONFIG"
	else
		warn "config missing: $CONFIG (run setup.sh)"
	fi

	if [ -f "${RESEARCHHARNESS_BRAND_LOGO:-}" ] && [ -f "${RESEARCHHARNESS_BRAND_TIPS:-}" ]; then
		ok "brand \"$RESEARCHHARNESS_BRAND_NAME\", logo ok, tips ok"
	else
		warn "brand \"$RESEARCHHARNESS_BRAND_NAME\" - logo or tips missing from $BRAND_DIR (welcome screen falls back to the stock omp mark/tips)"
	fi

	local jev_scripts jev_state
	jev_scripts="$RESEARCH_HARNESS_HOME/research/skills/literature-search/scripts"
	jev_state="$(python3 -c "
import sys
sys.path.insert(0, sys.argv[1])
import jev_client
key = jev_client.resolve_key()
if not key:
    print('off')
else:
    try:
        print('ready ' + ','.join(jev_client.list_models(key)))
    except Exception as exc:
        print('unreachable ' + type(exc).__name__)
" "$jev_scripts" 2>/dev/null || echo 'unreachable ImportError')"
	case "$jev_state" in
	ready*) ok "Jev first-pass enabled (models: ${jev_state#ready })" ;;
	off) warn "Jev first-pass OFF (optional - set TYPESAFE_API_KEY to enable)" ;;
	*) warn "Jev key set but API unreachable (${jev_state#unreachable }) - first pass will skip" ;;
	esac

	if [ -n "${RESEARCH_CORPUS_DIR:-}" ]; then
		if [ -d "$RESEARCH_CORPUS_DIR" ]; then
			ok "corpus $RESEARCH_CORPUS_DIR ($(find "$RESEARCH_CORPUS_DIR" -maxdepth 1 -name '*.pdf' 2>/dev/null | wc -l | tr -d ' ') PDFs)"
		else
			warn "corpus dir set but missing: $RESEARCH_CORPUS_DIR"
		fi
	else
		warn "corpus not set — web-only mode"
	fi

	if [ -f "$PAPER_GRAPH_DB" ]; then
		stats="$(python3 -c "
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
try:
    p = c.execute('SELECT COUNT(*) FROM papers').fetchone()[0]
    e = c.execute('SELECT COUNT(*) FROM edges').fetchone()[0]
    print(f'{p} papers, {e} edges')
except sqlite3.Error:
    print('unreadable')
" "$PAPER_GRAPH_DB" 2>/dev/null || echo unreadable)"
		ok "paper graph $PAPER_GRAPH_DB ($stats)"
	else
		warn "paper graph db not created yet ($PAPER_GRAPH_DB — created on first add)"
	fi

	local projects_dir="$HOME/.research-harness/projects"
	if [ -d "$projects_dir" ]; then
		count="$(find "$projects_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
		active=""
		if [ -f "$HOME/.research-harness/active-project" ]; then
			active=" (active: $(cat "$HOME/.research-harness/active-project"))"
		fi
		ok "projects $count under $projects_dir$active"
	else
		warn "projects dir missing (run setup.sh)"
	fi

	if [ "$DOCTOR_FAILED" -ne 0 ]; then
		echo "status: NOT READY — fix the FAIL lines above (usually: bash setup.sh)"
		return 1
	fi
	echo "status: ready — run 'research' to start"
	echo "        type /help in the TUI to see every command"
}

# `research update`: fetch the latest harness from GitHub and refresh the install.
# Git-based on purpose: the harness runs from this checkout, which `omp update` skips.
update() {
	local check=0
	if [ "${1:-}" = "--check" ]; then
		check=1
		shift
	fi
	if [ "$#" -gt 0 ]; then
		echo "research update: unexpected argument '$1' (usage: research update [--check])" >&2
		return 1
	fi

	local repo="$RESEARCH_HARNESS_HOME"
	if ! command -v git >/dev/null 2>&1; then
		echo "research update: git is not installed, so the harness cannot update itself." >&2
		return 1
	fi
	if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		echo "research update: $repo is not a git checkout — reinstall from https://github.com/LaansDole/research-harness" >&2
		return 1
	fi

	local branch
	branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"
	if [ "$branch" != "main" ]; then
		echo "research update: the harness is on branch '$branch', not 'main'. Switch back with: git -C \"$repo\" switch main" >&2
		return 1
	fi

	# Files the build regenerates (*.generated.*) are not user edits: the local
	# `bun install` postinstall rewrites them per machine. They get discarded and
	# rebuilt below instead of blocking the update; any other edit still blocks.
	local dirty blocking="" line entry regen=0
	local -a generated=()
	dirty="$(git -C "$repo" status --porcelain --untracked-files=no)"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		entry="${line:3}"
		case "$entry" in
		*.generated.*) generated+=("$entry") ;;
		*) blocking+="$line"$'\n' ;;
		esac
	done <<<"$dirty"
	if [ -n "$blocking" ]; then
		echo "research update: $repo has edits that are not saved in git:" >&2
		printf '%s' "$blocking" | sed 's/^.\{3\}/  /' >&2
		echo "Undo or commit them first, then run 'research update' again." >&2
		return 1
	fi

	# The fork's own remote wins; a plain clone only has origin.
	local remote="" r url
	for r in $(git -C "$repo" remote); do
		url="$(git -C "$repo" remote get-url "$r" 2>/dev/null || true)"
		case "$url" in
		*LaansDole/research-harness*)
			remote="$r"
			break
			;;
		esac
	done
	[ -n "$remote" ] || remote=origin

	local old pre new
	old="$(git -C "$repo" rev-parse HEAD)"
	pre="$(git -C "$repo" rev-parse --verify --quiet "refs/remotes/$remote/main" || true)"
	if ! git -C "$repo" fetch --quiet "$remote" main 2>/dev/null; then
		echo "research update: could not download the latest version from GitHub. Check your internet connection and try again." >&2
		return 1
	fi
	new="$(git -C "$repo" rev-parse FETCH_HEAD)"

	if [ "$new" = "$old" ]; then
		echo "research-harness is already up to date."
		return 0
	fi

	# After a force-push `old..new` counts the whole rebased stack, so count only
	# the commits whose content is not already in this copy.
	local count ff=0
	if git -C "$repo" merge-base --is-ancestor "$old" "$new"; then
		ff=1
		count="$(git -C "$repo" rev-list --count "$old..$new")"
	else
		count="$(git -C "$repo" rev-list --count --cherry-pick --right-only "$old...$new")"
	fi
	if [ "$check" -eq 1 ]; then
		echo "$count new commits available — run 'research update' to install them."
		echo "  latest: $(git -C "$repo" log -1 --format=%s "$new")"
		return 0
	fi

	if [ "${#generated[@]}" -gt 0 ]; then
		git -C "$repo" checkout HEAD -- "${generated[@]}"
		regen=1
	fi

	if [ "$ff" -eq 1 ]; then
		git -C "$repo" merge --ff-only --quiet "$new"
	else
		# Expected: the daily rebase-stack sync force-pushes main and keeps the
		# old tip as main-prev. Safe only if this copy added no commits of its own.
		local prev="" safe=0
		if [ -n "$pre" ] && git -C "$repo" merge-base --is-ancestor "$old" "$pre"; then
			safe=1
		else
			if git -C "$repo" fetch --quiet "$remote" main-prev 2>/dev/null; then
				prev="$(git -C "$repo" rev-parse FETCH_HEAD)"
			fi
			if [ -n "$prev" ] && git -C "$repo" merge-base --is-ancestor "$old" "$prev"; then
				safe=1
			fi
		fi
		if [ "$safe" -eq 0 ]; then
			echo "research update: GitHub rebuilt the history, and this copy has work that is not on GitHub:" >&2
			git -C "$repo" log --format='  %h %s' "$new..$old" >&2
			echo "Nothing was changed. Keep that work on its own branch, then update:" >&2
			echo "  git -C \"$repo\" branch my-work" >&2
			echo "  git -C \"$repo\" reset --keep ${new:0:7}" >&2
			return 1
		fi
		git -C "$repo" reset --keep "$new" >/dev/null
		echo "GitHub rebuilt the history; this copy now matches it."
		echo "  previous version: ${old:0:7} (go back with: git -C \"$repo\" reset --keep ${old:0:7})"
	fi

	local deps
	deps="$(git -C "$repo" diff --name-only "$old" "$new" -- package.json bun.lock)"
	if [ -n "$deps" ] || [ "$regen" -eq 1 ]; then
		if ! command -v bun >/dev/null 2>&1; then
			echo "research update: bun is not installed, so dependencies and build files were not rebuilt — install bun and run 'bun install' in $repo." >&2
		else
			echo "Updating dependencies..."
			local bun_out
			if ! bun_out="$(cd "$repo" && bun install 2>&1)"; then
				printf '%s\n' "$bun_out" | tail -20 >&2
				echo "research update: 'bun install' failed in $repo — run it there by hand to see why." >&2
				return 1
			fi
		fi
	fi

	echo "Refreshing the install..."
	local setup_out
	if ! setup_out="$(bash "$repo/setup.sh" </dev/null 2>&1)"; then
		printf '%s\n' "$setup_out" >&2
		echo "research update: the install step failed (see above). The files are updated; retry with: bash \"$repo/setup.sh\"" >&2
		return 1
	fi

	local rc=0
	doctor || rc=$?
	echo "research-harness updated ${old:0:7} -> ${new:0:7} ($count new commits)"
	return "$rc"
}

# Prefer the fork's dev wrapper (runs src/ through bun) so fork-level features,
# including branding, are live; RESEARCH_HARNESS_OMP overrides; without bun or
# the repo's node_modules the wrapper cannot start, so use the installed omp.
DEV_OMP="$RESEARCH_HARNESS_HOME/packages/coding-agent/scripts/omp"
if [ -n "${RESEARCH_HARNESS_OMP:-}" ]; then
	OMP_BIN="$RESEARCH_HARNESS_OMP"
elif [ -x "$DEV_OMP" ] && [ -d "$RESEARCH_HARNESS_HOME/node_modules" ] && command -v bun >/dev/null 2>&1; then
	OMP_BIN="$DEV_OMP"
else
	OMP_BIN="omp"
fi
case "${1:-}" in
doctor)
	doctor
	exit $?
	;;
update)
	shift
	update "$@"
	exit $?
	;;
web)
	if ! command -v bun >/dev/null 2>&1 || [ ! -d "$RESEARCH_HARNESS_HOME/node_modules" ]; then
		echo "research web: needs bun and the repo's node_modules (run 'bun install' in $RESEARCH_HARNESS_HOME)" >&2
		exit 1
	fi
	if [ ! -f "$SYSTEM_PROMPT" ]; then
		echo "research: mode system prompt not found at $SYSTEM_PROMPT — run setup.sh" >&2
		exit 1
	fi
	export RESEARCH_WEB_OMP="$OMP_BIN"
	export RESEARCH_SYSTEM_PROMPT="$SYSTEM_PROMPT"
	exec bun "$RESEARCH_HARNESS_HOME/packages/research-web/src/server.ts"
	;;
esac

if [ ! -f "$SYSTEM_PROMPT" ]; then
	echo "research: mode system prompt not found at $SYSTEM_PROMPT — run setup.sh" >&2
	exit 1
fi

args=(--append-system-prompt "$SYSTEM_PROMPT")
# omp auto-switches out of ~; prefer the research state home as the working dir.
if [ "$PWD" = "$HOME" ]; then
	args+=(--cwd "$HOME/.research-harness")
fi

exec "$OMP_BIN" "${args[@]}" "$@"
