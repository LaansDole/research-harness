{
	"type": "module",
	"name": "@oh-my-pi/research-web",
	"version": "0.0.0",
	"private": true,
	"description": "Local browser UI for the research harness (research web)",
	"scripts": {
		"dev": "bun run src/server.ts",
		"test": "bun test",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.client.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"dependencies": {
		"@oh-my-pi/pi-agent-core": "workspace:*",
		"@oh-my-pi/pi-ai": "workspace:*",
		"@oh-my-pi/collab-web": "workspace:*",
		"@oh-my-pi/pi-coding-agent": "workspace:*",
		"@oh-my-pi/pi-utils": "workspace:*",
		"@oh-my-pi/pi-wire": "workspace:*",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
